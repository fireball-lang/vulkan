    }
}

impl SubpassDescriptionFlags : BitAnd[SubpassDescriptionFlags] {
    type Result = SubpassDescriptionFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum SubpassMergeStatusEXT : u32 {
    Merged = 0,
    Disallowed = 1,
    NotMergedSideEffects = 2,
    NotMergedSamplesMismatch = 3,
    NotMergedViewsMismatch = 4,
    NotMergedAliasing = 5,
    NotMergedDependencies = 6,
