pub enum SubgroupFeatureFlags : u32 {
    /// Basic subgroup operations
    Basic = 1,
    /// Vote subgroup operations
    Vote = 2,
    /// Arithmetic subgroup operations
    Arithmetic = 4,
    /// Ballot subgroup operations
    Ballot = 8,
    /// Shuffle subgroup operations
    Shuffle = 16,
    /// Shuffle relative subgroup operations
    ShuffleRelative = 32,
    /// Clustered subgroup operations
    Clustered = 64,
    /// Quad subgroup operations
    Quad = 128,
    Partitioned = 256,
    Rotate = 512,
    RotateClustered = 1024,
}

impl SubgroupFeatureFlags : BitNot {
    type Result = SubgroupFeatureFlags;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl SubgroupFeatureFlags : BitOr[SubgroupFeatureFlags] {
    type Result = SubgroupFeatureFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl SubgroupFeatureFlags : BitAnd[SubgroupFeatureFlags] {
    type Result = SubgroupFeatureFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum SubmitFlags : u32 {
    Protected = 1,
}

impl SubmitFlags : BitNot {
    type Result = SubmitFlags;

    pub func bit_not(self) Self {
        return ~(*self as u32) as Self;
    }
}

impl SubmitFlags : BitOr[SubmitFlags] {
    type Result = SubmitFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl SubmitFlags : BitAnd[SubmitFlags] {
    type Result = SubmitFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum SubpassContents : u32 {
    Inline = 0,
    SecondaryCommandBuffers = 1,
    InlineAndSecondaryCommandBuffers = 1000451000,
}

pub enum SubpassDescriptionFlags : u32 {
    FragmentRegion = 4,
    CustomResolve = 8,
