impl vulkan::Api {
    pub func instance(self) vulkan::Instance {
        return self.instance;
    }

    pub func device(self) vulkan::Device {
        return self.device;
    }
}

#[cfg(target_os = "windows")]
func open_library() ?os::Library {
    return os::Library::open("vulkan-1");
}

#[cfg(target_os = "linux")]
func open_library() ?os::Library {
    var library = os::Library::open("libvulkan.so.1");

    if (library.is_none()) {
        library = os::Library::open("libvulkan.so");
    }

    return library;
}

#[cfg(target_os = "macos")]
func open_library() ?os::Library {
    var library = os::Library::open("libvulkan.dylib");

    if (library.is_none()) {
        library = os::Library::open("libMoltenVK.dylib");
    }

    return library;
}

#[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "macos")))]
func open_library() ?os::Library {
    return os::Library::open("vulkan");
}

impl vulkan::Api {
    func stub_global_commands(mut self) {
        self.ref_create_instance = vulkan::stub_create_instance;
        self.ref_enumerate_instance_extension_properties = vulkan::stub_enumerate_instance_extension_properties;
        self.ref_enumerate_instance_layer_properties = vulkan::stub_enumerate_instance_layer_properties;
        self.ref_enumerate_instance_version = vulkan::stub_enumerate_instance_version;
        self.ref_get_instance_proc_addr = vulkan::stub_get_instance_proc_addr;
    }
}

impl vulkan::Api {
    /// Loads the Vulkan library and returns a new Api with the global
    /// level commands resolved. Returns none if no library could be
    /// opened or the loader does not provide vkGetInstanceProcAddr.
    ///
    /// Instance and device level commands are resolved later through
    /// set_instance and set_device.
    pub func load() ?&Api {
        var api = c::malloc(sizeof(Self)) as mut &Self;

        api.instance = vulkan::Instance::from_raw(0);
        api.device = vulkan::Device::from_raw(0);

        api.stub_global_commands();
        api.stub_instance_commands();
        api.stub_device_commands();

        var library = open_library()?;

        var symbol = library.get("vkGetInstanceProcAddr")?;
        api.ref_get_instance_proc_addr = symbol as vulkan::VkGetInstanceProcAddr;

        var ptr: mut *void;

        ptr = api.ref_get_instance_proc_addr(vulkan::Instance::from_raw(0), "vkCreateInstance".ptr);
        if (ptr != null) api.ref_create_instance = ptr as vulkan::CreateInstance;

        ptr = api.ref_get_instance_proc_addr(vulkan::Instance::from_raw(0), "vkEnumerateInstanceExtensionProperties".ptr);
        if (ptr != null) api.ref_enumerate_instance_extension_properties = ptr as vulkan::EnumerateInstanceExtensionProperties;

        ptr = api.ref_get_instance_proc_addr(vulkan::Instance::from_raw(0), "vkEnumerateInstanceLayerProperties".ptr);
        if (ptr != null) api.ref_enumerate_instance_layer_properties = ptr as vulkan::EnumerateInstanceLayerProperties;

        ptr = api.ref_get_instance_proc_addr(vulkan::Instance::from_raw(0), "vkEnumerateInstanceVersion".ptr);
        if (ptr != null) api.ref_enumerate_instance_version = ptr as vulkan::EnumerateInstanceVersion;

        ptr = api.ref_get_instance_proc_addr(vulkan::Instance::from_raw(0), "vkGetInstanceProcAddr".ptr);
        if (ptr != null) api.ref_get_instance_proc_addr = ptr as vulkan::GetInstanceProcAddr;

        return api;
    }
}

impl vulkan::Api {
    /// Sets the instance and (re)loads all instance level commands.
    /// A previously set device is cleared and its commands revert to
    /// stubs.
    pub func set_instance(mut self, instance: vulkan::Instance) {
        if (!instance.valid()) panic("cannot set an invalid instance");
        if (self.instance == instance) return;

        if (self.device.valid()) {
            self.device = vulkan::Device::from_raw(0);
            self.stub_device_commands();
        }

        if (self.instance.valid()) self.stub_instance_commands();

        self.instance = instance;
        self.load_instance_commands(instance);
    }
}

impl vulkan::Api {
    /// Sets the device and (re)loads all device level commands.
    pub func set_device(mut self, device: vulkan::Device) {
        if (!device.valid()) panic("cannot set an invalid device");
        if (!self.instance.valid()) panic("set_instance must be called before set_device");
        if (self.device == device) return;

        if (self.device.valid()) self.stub_device_commands();

        self.device = device;
        self.load_device_commands(device);
    }
}
